            new() { frontend, backend, csharp, aspnet, react, typescript, tailwind, localFirst, architecture, testing }),

        new ProjectCard(
            "SMC",
            true,
            "https://github.com/01y7z/SMC",
            "images/projects/smc-project.png",
            "BlueSky post utility focused on parsing, API calls, and tests.",
            "A Vue and TypeScript project for validating BlueSky post URLs and fetching public post data from the BlueSky API. " +
            "The useful part of this project is not the size of the app, but the discipline around edge cases: URL parsing, typed request helpers, user-facing validation, and failure states. " +
            "It also includes Vitest unit tests and Playwright end-to-end tests, which made it a focused exercise in making small frontend behavior reliable.",
            new() { frontend, vue, typescript, tailwind, testing }),

        new ProjectCard(
            "FestivalAPI",
            true,
            "https://github.com/GitUser4179/FestivalAPI",
            "images/projects/festivalapi-project.png",
            "Collaborative ASP.NET Core API with documented endpoints and SQLite persistence.",
            "A team-built API project in C# and ASP.NET Core targeting .NET 10. " +
