            new() { backend, csharp, aspnet, sqlServer }),

        new ProjectCard(
            "AFGR Bank",
            true,
            "https://github.com/FrusTrick/AFGRBank",
            "images/projects/afgr-bank-project.png",
            "Object-oriented banking system with accounts, transfers, loans, and currency conversion.",
